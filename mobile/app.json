{
  "expo": {
    "name": "QuizPulse",
    "slug": "quizpulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quizpulse.app"
    },
    "android": {
      "package": "com.quizpulse.app",
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d8abcdea-95af-4940-89d9-262c01d24312"
      }
    }
  }
}
